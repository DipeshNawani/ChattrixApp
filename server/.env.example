# Copy to .env for local development:  cp .env.example .env   then   npm run dev

# Supabase -> Connect -> "Session pooler" URI (replace [YOUR-PASSWORD]; URL-encode special chars, e.g. @ -> %40)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key
SUPABASE_BUCKET=chat-files

# Optional (a random secret is generated and stored in the database if you leave this out)
# JWT_SECRET=some-long-random-string
